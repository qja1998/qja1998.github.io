---
// Jekyll 시절 utterances 를 그대로 이어 간다. issue_term 은 Chirpy 기본값(pathname)이라
// 기존 이슈가 같은 글에 계속 붙는다.
---
<section class="mt-10" aria-label="댓글">
  <script
    is:inline
    src="https://utteranc.es/client.js"
    repo="qja1998/qja1998.github.io"
    issue-term="pathname"
    theme="preferred-color-scheme"
    crossorigin="anonymous"
    async></script>
</section>
