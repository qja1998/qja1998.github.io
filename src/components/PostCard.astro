---
import { getRelativeLocaleUrl } from "astro:i18n";
import { cover, readMinutes } from "@/utils/cover";
import { semanticColor } from "@/utils/related";
import { renderHero } from "@/utils/hero";
import config from "@/config";

interface Props {
  post: any;
  cat?: string;
  featured?: boolean;
}
const { post, cat = "", featured = false } = Astro.props;
const body: string = post.body ?? "";
const c = cover(post.data.title, post.data.categories ?? [], body);
// 커버 = 그 글에서 고른 조각 하나를 마크다운 그대로 그린 것.
// 고를 때도 그릴 때도 조각의 종류를 묻지 않는다(src/utils/hero.ts).
const hero = await renderHero(post.id);
// 커버 바탕색이 곧 이 글의 주제다. 밝기를 고정해 그리드가 한 톤으로 어우러진다.
const tone = semanticColor(post.id, 0.33) ?? "var(--pc-night)";
const toneDark = semanticColor(post.id, 0.28) ?? "var(--pc-night)";
const edge = semanticColor(post.id, 0.68, 0.16) ?? "var(--pc-lamp)";
const minutes = readMinutes(body);
const locale = Astro.currentLocale ?? config.site.lang;
const href = getRelativeLocaleUrl(locale, `posts/${post.id}/`);
const date = new Date(post.data.pubDatetime);
const dateStr = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
---

<a
  class="pc"
  href={href}
  data-cat={cat}
  data-featured={featured ? "" : undefined}
  style={`--tier:var(${c.token});--tone:${tone};--tone-dark:${toneDark};--edge:${edge}`}
>
  <div class="pc-cover">
    <span class="pc-top">
      <span class="pc-kind">{c.kind}</span>
      <span class="pc-id">{c.ident}</span>
      {c.tier && <span class="pc-tier">{c.tier}</span>}
    </span>
    <div class="pc-hero" set:html={hero} />
  </div>
  <div class="pc-body">
    <h2>{c.short}</h2>
    <p>{post.data.description}</p>
    <div class="pc-meta">
      {dateStr}<span>·</span>{minutes}분{
        post.data.tags?.[0] && (
          <>
            <span>·</span>
            {post.data.tags[0]}
          </>
        )
      }
    </div>
  </div>
</a>

<style>
  .pc {
    background: var(--pc-surface);
    border: 1px solid var(--pc-line);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }
  .pc:hover,
  .pc:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px -18px rgba(18, 48, 57, 0.5);
  }
  .pc:focus-visible {
    outline: 2px solid var(--pc-lamp);
    outline-offset: 3px;
  }

  /* 커버 = 그 글의 구조. night 에 도메인 색을 12% 섞어 카드마다 색온도가 달라진다.
     기본은 얇은 띠다 — 미니맵은 글을 고르는 데 기여하지 않으므로 면적을 적게 준다.
     대표 글(첫 카드) 하나만 큰 커버로 올려 인상을 남긴다. */
  .pc-cover {
    position: relative;
    height: 132px;
    background: var(--pc-night);
    background: var(--tone);
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 5px;
    padding: 0 16px 13px;
    overflow: hidden;
  }
  /* 도식 위에 글자를 얹으므로 아래쪽에 그늘을 깐다 */
  .pc-cover::before {
    content: "";
    position: absolute;
    inset: 40% 0 0 0;
    z-index: 1;
    background: linear-gradient(180deg, transparent, rgba(6, 16, 20, 0.45));
  }
  .pc-top {
    position: absolute;
    top: 11px;
    left: 16px;
    right: 16px;
    z-index: 2;
    display: flex;
    align-items: baseline;
    gap: 9px;
  }
  /* 커버 안의 조각.
     조각이 무엇인지 CSS 도 묻지 않는다 — 표·코드·수식·목록이 들어와도
     같은 규칙으로 작게 조판되고, 아래로 갈수록 흐려지며 잘린다.
     잘린 자리가 경계가 아니라 "이 아래로 이어진다" 로 읽히게 하는 게 목적이다. */
  .pc-hero {
    position: absolute;
    inset: 32px 16px 0;
    z-index: 0;
    overflow: hidden;
    color: #dfeaee;
    font-size: 9.5px;
    line-height: 1.55;
    -webkit-mask-image: linear-gradient(180deg, #000 0, #000 46%, transparent 94%);
    mask-image: linear-gradient(180deg, #000 0, #000 46%, transparent 94%);
  }
  .pc-hero :global(pre) {
    margin: 0;
    padding: 0;
    background: transparent !important;
    border: 0;
    font-size: inherit;
    line-height: inherit;
    white-space: pre;
  }
  .pc-hero :global(code) {
    font-family: var(--pc-mono);
    font-size: inherit;
    background: transparent;
    padding: 0;
  }
  /* 커버는 항상 어두우므로 라이트/다크 두 벌 중 다크 쪽 색만 쓴다 */
  .pc-hero :global(span) {
    color: var(--shiki-dark, inherit);
  }
  .pc-hero :global(table) {
    border-collapse: collapse;
    width: 100%;
    font-size: 9px;
  }
  .pc-hero :global(th),
  .pc-hero :global(td) {
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 2px 5px;
    text-align: left;
    white-space: nowrap;
    max-width: 12ch;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pc-hero :global(th) {
    font-weight: 700;
    background: rgba(255, 255, 255, 0.08);
  }
  .pc-hero :global(h1),
  .pc-hero :global(h2),
  .pc-hero :global(h3),
  .pc-hero :global(h4) {
    margin: 0 0 4px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .pc-hero :global(p) {
    margin: 0 0 4px;
  }
  .pc-hero :global(ul),
  .pc-hero :global(ol) {
    margin: 0;
    padding-left: 13px;
  }
  .pc-hero :global(blockquote) {
    margin: 0;
    padding-left: 8px;
    border-left: 2px solid rgba(255, 255, 255, 0.3);
  }
  .pc-hero :global(img) {
    max-width: 100%;
    filter: brightness(0.86);
  }
  .pc-hero :global(a) {
    color: inherit;
    text-decoration: none;
  }
  .pc-hero :global(.katex) {
    font-size: 15px;
    color: #fff;
  }
  .pc-hero :global(.katex-display) {
    margin: 0;
  }
  /* 대표 글은 커버가 크다 — 같은 조각을 읽을 수 있는 크기로 올린다 */
  .pc[data-featured] .pc-hero {
    inset: 44px 22px 0;
    font-size: 12.5px;
    -webkit-mask-image: linear-gradient(180deg, #000 0, #000 62%, transparent 97%);
    mask-image: linear-gradient(180deg, #000 0, #000 62%, transparent 97%);
  }
  .pc[data-featured] .pc-hero :global(table),
  .pc[data-featured] .pc-hero :global(th),
  .pc[data-featured] .pc-hero :global(td) {
    font-size: 11.5px;
    max-width: 20ch;
  }
  .pc[data-featured] .pc-hero :global(h1),
  .pc[data-featured] .pc-hero :global(h2),
  .pc[data-featured] .pc-hero :global(h3),
  .pc[data-featured] .pc-hero :global(h4) {
    font-size: 19px;
  }
  .pc[data-featured] .pc-hero :global(.katex) {
    font-size: 22px;
  }
  .pc-cover::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: var(--edge);
  }
  :global([data-theme="dark"]) .pc-cover {
    background: var(--tone-dark);
  }
  .pc-id {
    font-family: var(--pc-mono);
    font-weight: 700;
    font-size: 11px;
    color: #fff;
    opacity: 0.9;
    letter-spacing: 0.06em;
    text-shadow: 0 1px 10px rgba(8, 20, 25, 0.95);
    white-space: nowrap;
  }
  .pc-kind,
  .pc-tier {
    font-family: var(--pc-mono);
    text-shadow: 0 1px 10px rgba(8, 20, 25, 0.95);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pc-kind {
    font-weight: 500;
    color: #88a3ab;
  }
  /* 이 글이 어느 주제로 기울었는지. 커버 그림과 같은 축에서 나온 값이다. */
  .pc-lean {
    font-family: var(--pc-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #fff;
    text-shadow: 0 1px 10px rgba(8, 20, 25, 0.95);
    white-space: nowrap;
  }
  .pc-tier {
    font-weight: 700;
    color: var(--tier);
    letter-spacing: 0.14em;
  }

  .pc-body {
    padding: 19px 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 9px;
  }
  .pc-body h2 {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.42;
    letter-spacing: -0.02em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc-body p {
    margin: 0;
    font-size: 14px;
    color: var(--pc-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc-meta {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--pc-line);
    font-family: var(--pc-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--pc-muted);
    display: flex;
    gap: 9px;
    align-items: center;
    white-space: nowrap;
    overflow: hidden;
  }
  .pc-meta span {
    opacity: 0.45;
  }


  /* 대표 글: 그리드 한 줄을 통째로 쓰고 커버를 왼쪽에 크게 둔다.
     Cloudflare·Stripe·Tailwind 가 쓰는 형태다 — 커버 예산을 상위 1건에만 쓴다. */
  .pc[data-featured] {
    grid-column: 1 / -1;
    flex-direction: row;
  }
  .pc[data-featured] .pc-cover {
    height: auto;
    width: 42%;
    flex: none;
    justify-content: flex-end;
    padding: 0 22px 20px;
    gap: 9px;
    height: auto;
  }
  .pc[data-featured] .pc-lean {
    display: none;
  }
  .pc[data-featured] .pc-top {
    position: absolute;
    inset: 16px 20px auto;
    justify-content: flex-start;
  }

  .pc[data-featured] .pc-cover::after {
    inset: auto 0 0 0;
  }
  .pc[data-featured] .pc-body {
    padding: 26px 28px;
    justify-content: center;
    gap: 12px;
  }
  .pc[data-featured] .pc-body h2 {
    font-size: 24px;
    -webkit-line-clamp: 3;
  }
  .pc[data-featured] .pc-body p {
    font-size: 15px;
    -webkit-line-clamp: 3;
  }
  @media (max-width: 720px) {
    .pc[data-featured] {
      flex-direction: column;
    }
    .pc[data-featured] .pc-cover {
      width: 100%;
      aspect-ratio: 2 / 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc,
    .pc-id {
      transition: none;
    }
  }
</style>
