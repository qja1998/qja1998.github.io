---
import { getRelativeLocaleUrl } from "astro:i18n";
import { cover, minimapRects, readMinutes } from "@/utils/cover";
import config from "@/config";

interface Props {
  post: any;
  cat?: string;
}
const { post, cat = "" } = Astro.props;
const body: string = post.body ?? "";
const c = cover(post.data.title, post.data.categories ?? [], body);
const rects = minimapRects(c.minimap);
const minutes = readMinutes(body);
const locale = Astro.currentLocale ?? config.site.lang;
const href = getRelativeLocaleUrl(locale, `posts/${post.id}/`);
const date = new Date(post.data.pubDatetime);
const dateStr = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
const isNum = /^\d+$/.test(c.ident);
---

<a class="pc" href={href} data-cat={cat} style={`--tier:var(${c.token})`}>
  <div class="pc-cover">
    <svg
      class="pc-mm"
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      {
        rects.map(r => (
          <rect
            x={r.x.toFixed(2)}
            y={r.y.toFixed(2)}
            width={r.w.toFixed(2)}
            height={r.h.toFixed(2)}
            rx={(r.h / 2).toFixed(2)}
            fill="#fff"
            opacity={r.o.toFixed(2)}
          />
        ))
      }
    </svg>
    <span class="pc-kind">{c.kind}</span>
    {c.tier && <span class="pc-tier">{c.tier}</span>}
    <span class={isNum ? "pc-id" : "pc-id pc-id-sm"}>{c.ident}</span>
  </div>
  <div class="pc-body">
    <h2>{c.short}</h2>
    <p>{post.data.description}</p>
    <div class="pc-meta">
      {dateStr}<span>·</span>{minutes}분{
        post.data.tags?.[0] && (
          <>
            <span>·</span>
            {post.data.tags[0]}
          </>
        )
      }
    </div>
  </div>
</a>

<style>
  .pc {
    background: var(--pc-surface);
    border: 1px solid var(--pc-line);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }
  .pc:hover,
  .pc:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px -18px rgba(18, 48, 57, 0.5);
  }
  .pc:focus-visible {
    outline: 2px solid var(--pc-lamp);
    outline-offset: 3px;
  }

  /* 커버 = 그 글의 구조. night 에 도메인 색을 12% 섞어 카드마다 색온도가 달라진다. */
  .pc-cover {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--pc-night);
    background: color-mix(in oklab, var(--pc-night) 88%, var(--tier));
    color: #fff;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 0 16px 14px;
    overflow: hidden;
  }
  .pc-cover::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: var(--tier);
  }
  .pc-mm {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.9;
  }
  .pc-id {
    position: relative;
    z-index: 2;
    font-family: var(--pc-mono);
    font-weight: 800;
    font-size: clamp(26px, 3.2vw, 36px);
    letter-spacing: -0.03em;
    line-height: 1;
    text-shadow: 0 2px 20px rgba(8, 20, 25, 0.9);
    transition: transform 0.22s ease;
  }
  .pc-id-sm {
    font-size: clamp(17px, 2vw, 22px);
    letter-spacing: -0.01em;
  }
  .pc:hover .pc-id {
    transform: translateY(-3px);
  }
  .pc-kind,
  .pc-tier {
    position: absolute;
    top: 13px;
    z-index: 2;
    font-family: var(--pc-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .pc-kind {
    left: 15px;
    font-weight: 500;
    color: #88a3ab;
  }
  .pc-tier {
    right: 15px;
    font-weight: 700;
    color: var(--tier);
    letter-spacing: 0.14em;
  }

  .pc-body {
    padding: 19px 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 9px;
  }
  .pc-body h2 {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.42;
    letter-spacing: -0.02em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc-body p {
    margin: 0;
    font-size: 14px;
    color: var(--pc-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc-meta {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--pc-line);
    font-family: var(--pc-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--pc-muted);
    display: flex;
    gap: 9px;
    align-items: center;
    white-space: nowrap;
    overflow: hidden;
  }
  .pc-meta span {
    opacity: 0.45;
  }

  @media (max-width: 560px) {
    .pc-cover {
      aspect-ratio: 2 / 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pc,
    .pc-id {
      transition: none;
    }
  }
</style>
