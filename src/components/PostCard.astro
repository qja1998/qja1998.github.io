---
import { getRelativeLocaleUrl } from "astro:i18n";
import { cover, readMinutes } from "@/utils/cover";
import { fingerprint } from "@/utils/related";
import { coverShape, type Shape } from "@/utils/coverShape";
import { COVER_BAND, COVER_FEATURED } from "@/utils/coverConfig";
import config from "@/config";

interface Props {
  post: any;
  cat?: string;
  featured?: boolean;
}
const { post, cat = "", featured = false } = Astro.props;
const body: string = post.body ?? "";
const c = cover(post.data.title, post.data.categories ?? [], body);
// 커버 = 이 글의 의미 지문. 임베딩을 PCA 로 32축에 눌러 표준화한 값이다.
// 비슷한 글끼리 지문이 닮는다 — 코드 구조가 아니라 내용이 만든 그림이다.
const fp = fingerprint(post.id);
const svg = coverShape(fp, (featured ? COVER_FEATURED : COVER_BAND) as Shape);
const minutes = readMinutes(body);
const locale = Astro.currentLocale ?? config.site.lang;
const href = getRelativeLocaleUrl(locale, `posts/${post.id}/`);
const date = new Date(post.data.pubDatetime);
const dateStr = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
const isNum = /^\d+$/.test(c.ident);
---

<a
  class="pc"
  href={href}
  data-cat={cat}
  data-featured={featured ? "" : undefined}
  style={`--tier:var(${c.token})`}
>
  <div class="pc-cover">
    <svg
      class="pc-fp"
      viewBox="0 0 100 100"
      preserveAspectRatio={featured ? "xMidYMid meet" : "none"}
      aria-hidden="true"
      set:html={svg}
    />
    <span class="pc-top">
      <span class="pc-kind">{c.kind}</span>
      {c.tier && <span class="pc-tier">{c.tier}</span>}
    </span>
    <span class={isNum ? "pc-id" : "pc-id pc-id-sm"}>{c.ident}</span>
  </div>
  <div class="pc-body">
    <h2>{c.short}</h2>
    <p>{post.data.description}</p>
    <div class="pc-meta">
      {dateStr}<span>·</span>{minutes}분{
        post.data.tags?.[0] && (
          <>
            <span>·</span>
            {post.data.tags[0]}
          </>
        )
      }
    </div>
  </div>
</a>

<style>
  .pc {
    background: var(--pc-surface);
    border: 1px solid var(--pc-line);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }
  .pc:hover,
  .pc:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px -18px rgba(18, 48, 57, 0.5);
  }
  .pc:focus-visible {
    outline: 2px solid var(--pc-lamp);
    outline-offset: 3px;
  }

  /* 커버 = 그 글의 구조. night 에 도메인 색을 12% 섞어 카드마다 색온도가 달라진다.
     기본은 얇은 띠다 — 미니맵은 글을 고르는 데 기여하지 않으므로 면적을 적게 준다.
     대표 글(첫 카드) 하나만 큰 커버로 올려 인상을 남긴다. */
  .pc-cover {
    position: relative;
    height: 66px;
    background: var(--pc-night);
    background: color-mix(in oklab, var(--pc-night) 88%, var(--tier));
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 16px;
    overflow: hidden;
  }
  .pc-top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .pc-cover::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: var(--tier);
  }
  .pc-fp {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.34;
  }
  .pc-fp :global(line) {
    stroke: #fff;
    stroke-width: 0.4;
    opacity: 0.22;
  }
  .pc-id {
    position: relative;
    z-index: 2;
    font-family: var(--pc-mono);
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -0.03em;
    line-height: 1;
    text-shadow: 0 2px 20px rgba(8, 20, 25, 0.9);
    transition: transform 0.22s ease;
  }
  .pc-id-sm {
    font-size: 15px;
    letter-spacing: -0.01em;
  }
  .pc:hover .pc-id {
    transform: translateY(-3px);
  }
  .pc-kind,
  .pc-tier {
    font-family: var(--pc-mono);
    text-shadow: 0 1px 10px rgba(8, 20, 25, 0.95);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pc-kind {
    font-weight: 500;
    color: #88a3ab;
  }
  .pc-tier {
    font-weight: 700;
    color: var(--tier);
    letter-spacing: 0.14em;
  }

  .pc-body {
    padding: 19px 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 9px;
  }
  .pc-body h2 {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.42;
    letter-spacing: -0.02em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc-body p {
    margin: 0;
    font-size: 14px;
    color: var(--pc-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc-meta {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--pc-line);
    font-family: var(--pc-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--pc-muted);
    display: flex;
    gap: 9px;
    align-items: center;
    white-space: nowrap;
    overflow: hidden;
  }
  .pc-meta span {
    opacity: 0.45;
  }


  /* 대표 글: 그리드 한 줄을 통째로 쓰고 커버를 왼쪽에 크게 둔다.
     Cloudflare·Stripe·Tailwind 가 쓰는 형태다 — 커버 예산을 상위 1건에만 쓴다. */
  .pc[data-featured] {
    grid-column: 1 / -1;
    flex-direction: row;
  }
  .pc[data-featured] .pc-cover {
    height: auto;
    width: 42%;
    flex: none;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 0 20px 18px;
  }
  .pc[data-featured] .pc-fp {
    opacity: 0.92;
  }
  .pc[data-featured] .pc-top {
    position: absolute;
    inset: 14px 18px auto;
    justify-content: space-between;
  }
  .pc[data-featured] .pc-id {
    font-size: clamp(30px, 3.4vw, 42px);
  }
  .pc[data-featured] .pc-id-sm {
    font-size: clamp(19px, 2.2vw, 26px);
  }
  .pc[data-featured] .pc-cover::after {
    inset: auto 0 0 0;
  }
  .pc[data-featured] .pc-body {
    padding: 26px 28px;
    justify-content: center;
    gap: 12px;
  }
  .pc[data-featured] .pc-body h2 {
    font-size: 24px;
    -webkit-line-clamp: 3;
  }
  .pc[data-featured] .pc-body p {
    font-size: 15px;
    -webkit-line-clamp: 3;
  }
  @media (max-width: 720px) {
    .pc[data-featured] {
      flex-direction: column;
    }
    .pc[data-featured] .pc-cover {
      width: 100%;
      aspect-ratio: 2 / 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc,
    .pc-id {
      transition: none;
    }
  }
</style>
