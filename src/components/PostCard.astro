---
import { getRelativeLocaleUrl } from "astro:i18n";
import { cover, readMinutes } from "@/utils/cover";
import { fingerprint } from "@/utils/related";
import { semanticColor, keyTerms } from "@/utils/related";
import { coverSource } from "@/utils/coverSource";
import katex from "katex";
import config from "@/config";

interface Props {
  post: any;
  cat?: string;
  featured?: boolean;
}
const { post, cat = "", featured = false } = Astro.props;
const body: string = post.body ?? "";
const c = cover(post.data.title, post.data.categories ?? [], body);
// 커버 = 이 글의 의미 지문. 임베딩을 PCA 로 32축에 눌러 표준화한 값이다.
// 비슷한 글끼리 지문이 닮는다 — 코드 구조가 아니라 내용이 만든 그림이다.
const fp = fingerprint(post.id);
// 본문이 너무 짧아 낱말을 못 뽑은 글이 1편 있다. 커버가 비는 것보다 제목이 낫다.
// 커버 = 그 글에서 뽑은 낱말들의 조판.
// 세로는 점수 순으로 쌓아 늘 읽히게 하고, 가로 들여쓰기는 낱말끼리의 의미 좌표에서
// 가져온다. 정해 둔 도식이 없어 어떤 주제가 들어와도 그대로 돈다.
// 커버는 그 글이 실제로 갖고 있는 것으로 채운다 — 그림 · 수식 · 코드 구조,
// 셋 다 없으면 본문에서 뽑은 낱말.
const src = coverSource(body);
const tex =
  src.kind === "formula"
    ? katex.renderToString(src.tex, { throwOnError: false, displayMode: false })
    : "";

const raw = keyTerms(post.id);
const shown = (raw.length ? raw : [{ w: c.short, s: 1, x: 0, y: 0 }]).slice(0, featured ? 6 : 4);
const terms = shown.map((t, i) => ({
  ...t,
  size: featured ? 30 - i * 3.6 : 19 - i * 2.6,
  indent: Math.round(t.x * (featured ? 96 : 62)),
  op: 0.45 + t.s * 0.55,
}));
// 커버 바탕색이 곧 이 글의 주제다. 밝기를 고정해 그리드가 한 톤으로 어우러진다.
const tone = semanticColor(post.id, 0.33) ?? "var(--pc-night)";
const toneDark = semanticColor(post.id, 0.28) ?? "var(--pc-night)";
const edge = semanticColor(post.id, 0.68, 0.16) ?? "var(--pc-lamp)";
const minutes = readMinutes(body);
const locale = Astro.currentLocale ?? config.site.lang;
const href = getRelativeLocaleUrl(locale, `posts/${post.id}/`);
const date = new Date(post.data.pubDatetime);
const dateStr = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
---

<a
  class="pc"
  href={href}
  data-cat={cat}
  data-featured={featured ? "" : undefined}
  style={`--tier:var(${c.token});--tone:${tone};--tone-dark:${toneDark};--edge:${edge}`}
>
  <div class="pc-cover">
    <span class="pc-top">
      <span class="pc-kind">{c.kind}</span>
      <span class="pc-id">{c.ident}</span>
      {c.tier && <span class="pc-tier">{c.tier}</span>}
    </span>
    {
      src.kind === "image" && (
        <>
          <img class="pc-img" src={src.src} alt="" loading="lazy" />
          {/* 밝은 그림 위에서 라벨이 묻히지 않게 위쪽에 그늘을 깐다 */}
          <span class="pc-scrim" />
        </>
      )
    }
    {src.kind === "formula" && <span class="pc-tex" set:html={tex} />}
    {
      src.kind === "code" && (
        <svg class="pc-code" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {src.rects.map(r => (
            <rect
              x={r.x.toFixed(2)}
              y={r.y.toFixed(2)}
              width={r.w.toFixed(2)}
              height={r.h.toFixed(2)}
              rx={(r.h / 2).toFixed(2)}
              fill="#fff"
              opacity={r.o.toFixed(2)}
            />
          ))}
        </svg>
      )
    }
    {
      src.kind === "terms" && (
        <span class="pc-terms">
          {terms.map(t => (
            <b style={`font-size:${t.size}px;padding-left:${t.indent}px;opacity:${t.op.toFixed(2)}`}>
              {t.w}
            </b>
          ))}
        </span>
      )
    }
  </div>
  <div class="pc-body">
    <h2>{c.short}</h2>
    <p>{post.data.description}</p>
    <div class="pc-meta">
      {dateStr}<span>·</span>{minutes}분{
        post.data.tags?.[0] && (
          <>
            <span>·</span>
            {post.data.tags[0]}
          </>
        )
      }
    </div>
  </div>
</a>

<style>
  .pc {
    background: var(--pc-surface);
    border: 1px solid var(--pc-line);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }
  .pc:hover,
  .pc:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px -18px rgba(18, 48, 57, 0.5);
  }
  .pc:focus-visible {
    outline: 2px solid var(--pc-lamp);
    outline-offset: 3px;
  }

  /* 커버 = 그 글의 구조. night 에 도메인 색을 12% 섞어 카드마다 색온도가 달라진다.
     기본은 얇은 띠다 — 미니맵은 글을 고르는 데 기여하지 않으므로 면적을 적게 준다.
     대표 글(첫 카드) 하나만 큰 커버로 올려 인상을 남긴다. */
  .pc-cover {
    position: relative;
    height: 132px;
    background: var(--pc-night);
    background: var(--tone);
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 5px;
    padding: 0 16px 13px;
    overflow: hidden;
  }
  /* 도식 위에 글자를 얹으므로 아래쪽에 그늘을 깐다 */
  .pc-cover::before {
    content: "";
    position: absolute;
    inset: 40% 0 0 0;
    z-index: 1;
    background: linear-gradient(180deg, transparent, rgba(6, 16, 20, 0.72));
  }
  .pc-top {
    position: absolute;
    top: 11px;
    left: 16px;
    right: 16px;
    z-index: 2;
    display: flex;
    align-items: baseline;
    gap: 9px;
  }
  /* 본문에서 뽑은 말. 커버에서 가장 크게 — 사람이 의미를 읽는 자리다. */
  .pc-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 본문 도식은 대부분 흰 배경이라 그대로 두면 카드가 하얗게 뜬다.
       살짝 눌러 어두운 카드 계열에 맞추고, 라벨은 칩으로 띄운다. */
    opacity: 0.9;
    filter: brightness(0.78) saturate(0.95);
  }
  .pc-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(6, 16, 20, 0.72) 0, transparent 44%),
      linear-gradient(0deg, rgba(6, 16, 20, 0.6) 0, transparent 40%);
  }
  .pc-code {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.85;
  }
  .pc-tex {
    position: relative;
    z-index: 2;
    color: #fff;
    font-size: 17px;
    max-width: 100%;
    overflow: hidden;
    align-self: center;
    margin: auto 0;
  }
  .pc-terms {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    width: 100%;
    color: #fff;
  }
  .pc-terms b {
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-shadow: 0 1px 12px rgba(8, 20, 25, 0.45);
  }
  .pc-cover::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: var(--edge);
  }
  :global([data-theme="dark"]) .pc-cover {
    background: var(--tone-dark);
  }
  .pc-id {
    font-family: var(--pc-mono);
    font-weight: 700;
    font-size: 11px;
    color: #fff;
    opacity: 0.9;
    letter-spacing: 0.06em;
    text-shadow: 0 1px 10px rgba(8, 20, 25, 0.95);
    white-space: nowrap;
  }
  .pc-kind,
  .pc-tier {
    font-family: var(--pc-mono);
    text-shadow: 0 1px 10px rgba(8, 20, 25, 0.95);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pc-kind {
    font-weight: 500;
    color: #88a3ab;
  }
  /* 이 글이 어느 주제로 기울었는지. 커버 그림과 같은 축에서 나온 값이다. */
  .pc-lean {
    font-family: var(--pc-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #fff;
    text-shadow: 0 1px 10px rgba(8, 20, 25, 0.95);
    white-space: nowrap;
  }
  .pc-tier {
    font-weight: 700;
    color: var(--tier);
    letter-spacing: 0.14em;
  }

  .pc-body {
    padding: 19px 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 9px;
  }
  .pc-body h2 {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.42;
    letter-spacing: -0.02em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc-body p {
    margin: 0;
    font-size: 14px;
    color: var(--pc-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc-meta {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--pc-line);
    font-family: var(--pc-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--pc-muted);
    display: flex;
    gap: 9px;
    align-items: center;
    white-space: nowrap;
    overflow: hidden;
  }
  .pc-meta span {
    opacity: 0.45;
  }


  /* 대표 글: 그리드 한 줄을 통째로 쓰고 커버를 왼쪽에 크게 둔다.
     Cloudflare·Stripe·Tailwind 가 쓰는 형태다 — 커버 예산을 상위 1건에만 쓴다. */
  .pc[data-featured] {
    grid-column: 1 / -1;
    flex-direction: row;
  }
  .pc[data-featured] .pc-cover {
    height: auto;
    width: 42%;
    flex: none;
    justify-content: flex-end;
    padding: 0 22px 20px;
    gap: 9px;
    height: auto;
  }
  .pc[data-featured] .pc-lean {
    display: none;
  }
  .pc[data-featured] .pc-top {
    position: absolute;
    inset: 16px 20px auto;
    justify-content: flex-start;
  }

  .pc[data-featured] .pc-cover::after {
    inset: auto 0 0 0;
  }
  .pc[data-featured] .pc-body {
    padding: 26px 28px;
    justify-content: center;
    gap: 12px;
  }
  .pc[data-featured] .pc-body h2 {
    font-size: 24px;
    -webkit-line-clamp: 3;
  }
  .pc[data-featured] .pc-body p {
    font-size: 15px;
    -webkit-line-clamp: 3;
  }
  @media (max-width: 720px) {
    .pc[data-featured] {
      flex-direction: column;
    }
    .pc[data-featured] .pc-cover {
      width: 100%;
      aspect-ratio: 2 / 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc,
    .pc-id {
      transition: none;
    }
  }
</style>
