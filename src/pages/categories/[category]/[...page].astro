---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import PostGrid from "@/components/PostGrid.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getUniqueCategories, primaryCategory } from "@/utils/getUniqueCategories";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return getUniqueCategories(posts).flatMap(({ category, name }) =>
    paginate(getSortedPosts(posts.filter(p => primaryCategory(p) === category)), {
      params: { category },
      props: { name },
      pageSize: config.posts.perPage,
    })
  );
}

const { page, name } = Astro.props;
---

<Layout title={`카테고리: ${name} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle={`카테고리: ${name}`} pageDesc={`"${name}" 로 분류된 글.`} layout="grid">
    <PostGrid posts={page.data} />
  </Main>
  <Pagination {page} />
  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
