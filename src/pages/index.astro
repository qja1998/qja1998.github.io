---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostGrid from "@/components/PostGrid.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueCategories } from "@/utils/getUniqueCategories";
import { categoryHue } from "@/utils/related";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const HOME = config.posts.perIndex;   // "전체" 에서 보여 줄 개수
const PER_CAT = 12;                   // 칩 하나를 눌렀을 때 보여 줄 개수

// 칩은 필터라서 누르는 즉시 걸릴 카드가 DOM 에 있어야 한다. 그렇다고 165장을
// 다 넣으면 500KB 다. 카테고리마다 최근 PER_CAT 개까지만 넣고 나머지는
// 카테고리 페이지로 보낸다.
const perCat = new Map<string, number>();
const rendered = posts.filter((p, i) => {
  const cat = p.data.categories?.[0] ?? "";
  const n = (perCat.get(cat) ?? 0) + 1;
  perCat.set(cat, n);
  return i < HOME || n <= PER_CAT;
});

// 스펙트럼 밴드 — 165개를 실제 분류 비율대로 띠 하나에 담는다.
// Horizone 의 필터 칩을 데이터 비율로 바꾼 것이고, 사진 없는 그리드에 색을 주는 유일한 자리다.
const SEGMENTS: { label: string; token: string; match: (c: string[]) => boolean }[] = [
  { label: "백준 골드", token: "--d-gold", match: c => c[0] === "boj" && c[1] === "gold" },
  { label: "백준 실버", token: "--d-silver", match: c => c[0] === "boj" && c[1] === "silver" },
  { label: "백준 브론즈", token: "--d-bronze", match: c => c[0] === "boj" && c[1] === "bronze" },
  { label: "프로그래머스", token: "--d-sql", match: c => c[0] === "programmers" },
  { label: "PyTorch", token: "--d-torch", match: c => c[0] === "pytorch" },
  { label: "트러블슈팅", token: "--d-trouble", match: c => c[0] === "troubleshooting" },
  { label: "Docker", token: "--d-docker", match: c => c[0] === "docker" },
  { label: "배경지식", token: "--d-base", match: c => c[0] === "background" },
  { label: "SWEA", token: "--d-swea", match: c => c[0] === "swea" },
];
const counts = SEGMENTS.map(seg => {
  const mem = posts.filter(p => seg.match(p.data.categories ?? []));
  const h = categoryHue(mem.map(p => p.id));
  return { ...seg, n: mem.length, color: h === null ? "var(--pc-line)" : `oklch(0.58 0.14 ${h.toFixed(1)})` };
}).filter(s => s.n > 0);
const other = posts.length - counts.reduce((a, b) => a + b.n, 0);

// 칩은 실제로 갈 수 있는 곳이어야 한다. 밴드는 티어까지 쪼개 보여 주지만
// 라우트가 있는 단위는 대분류(boj, programmers …)라 칩은 그 단위로 만든다.
const LABEL: Record<string, string> = {
  boj: "백준",
  programmers: "프로그래머스",
  pytorch: "PyTorch",
  troubleshooting: "트러블슈팅",
  docker: "Docker",
  background: "배경지식",
  swea: "SWEA",
  "generative-model": "생성모델",
};
const CHIP_TOKEN: Record<string, string> = {
  boj: "--d-gold",
  programmers: "--d-sql",
  pytorch: "--d-torch",
  troubleshooting: "--d-trouble",
  docker: "--d-docker",
  background: "--d-base",
  swea: "--d-swea",
  "generative-model": "--d-bronze",
};
const chips = getUniqueCategories(await getCollection("posts")).map(c => {
  const mem = posts.filter(p => (p.data.categories?.[0] ?? "") === c.name).map(p => p.id);
  const h = categoryHue(mem);
  return { ...c, color: h === null ? "var(--pc-line)" : `oklch(0.55 0.13 ${h.toFixed(1)})` };
});

const dates = posts.map(p => new Date(p.data.pubDatetime)).sort((a, b) => +a - +b);
const span = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}`;
const range = dates.length ? `${span(dates[0])} — ${span(dates[dates.length - 1])}` : "";
const postsPath = getRelativeLocaleUrl(locale, "posts/");
const tagsPath = getRelativeLocaleUrl(locale, "tags/");
---

<Layout>
  <Header />
  <main id="main-content" data-layout="grid" class="app-layout my-1">
    <section class="hero">
      <p class="eyebrow">{posts.length} POSTS · {range}</p>
      <h1>막힌 걸 풀고,<br />왜 그렇게 풀렸는지 적어 둡니다.</h1>
      <p class="lede">{config.site.description}</p>

      <div class="spectrum">
        <div
          class="bar"
          role="img"
          aria-label={counts.map(c => `${c.label} ${c.n}`).join(", ")}
        >
          {
            counts.map(c => (
              <span style={`flex:${c.n};background:${c.color}`} title={`${c.label} ${c.n}`} />
            ))
          }
          {other > 0 && <span style={`flex:${other};background:var(--pc-line)`} title={`기타 ${other}`} />}
        </div>
        <div class="legend">
          <a href={postsPath} data-cat="" aria-current="true">
            <span class="dot" style="background:var(--pc-night)"></span>전체
            <span class="n">{posts.length}</span>
          </a>
          {
            chips.map(c => (
              <a
                href={getRelativeLocaleUrl(locale, `categories/${c.category}/`)}
                data-cat={c.name}
                data-count={c.count}
                data-label={LABEL[c.category] ?? c.name}
              >
                <span class="dot" style={`background:${c.color}`} />
                {LABEL[c.category] ?? c.name}
                <span class="n">{c.count}</span>
              </a>
            ))
          }
          <a href={tagsPath}>태그 전체 →</a>
        </div>
      </div>
    </section>

    <PostGrid posts={rendered} featureFirst id="grid" home={HOME} perCat={PER_CAT} />

    <a class="more" id="more" href={postsPath} data-all-href={postsPath}>
      전체 {posts.length}개 보기 →
    </a>
  </main>
  <Footer />
</Layout>

<script is:inline>
  // 칩은 진짜 링크다(JS 가 꺼져 있거나 크롤러가 오면 카테고리 페이지로 간다).
  // JS 가 있으면 이동 대신 그리드를 제자리에서 거른다 — 생김새가 필터니까.
  (() => {
    const grid = document.getElementById("grid");
    const more = document.getElementById("more");
    if (!grid || !more) return;
    const chips = [...document.querySelectorAll(".legend a[data-cat]")];
    const cards = [...grid.querySelectorAll("[data-cat]")];
    const HOME = +grid.dataset.home || 9;
    const PER_CAT = +grid.dataset.perCat || 12;
    const allHref = more.dataset.allHref;
    const allText = more.textContent.trim();

    function apply(cat, chip) {
      const limit = cat ? PER_CAT : HOME;
      let shown = 0;
      for (const card of cards) {
        const hit = (!cat || card.dataset.cat === cat) && shown < limit;
        card.hidden = !hit;
        // 걸러진 목록의 첫 카드가 그때그때 대표 글이 된다
        card.toggleAttribute("data-featured", hit && shown === 0);
        if (hit) shown++;
      }
      chips.forEach(a => a.setAttribute("aria-current", String(a === chip)));
      const total = chip ? +chip.dataset.count || 0 : 0;
      more.href = cat ? chip.getAttribute("href") : allHref;
      more.textContent =
        cat && total > shown
          ? `${chip.dataset.label} ${total}개 전체 보기 →`
          : cat
            ? `${chip.dataset.label} 페이지로 →`
            : allText;
      history.replaceState(null, "", cat ? `#${encodeURIComponent(cat)}` : location.pathname);
    }

    chips.forEach(chip =>
      chip.addEventListener("click", e => {
        // 새 탭·저장 의도는 그대로 둔다
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        apply(chip.dataset.cat, chip);
      })
    );

    const initial = decodeURIComponent(location.hash.slice(1));
    const chip = chips.find(a => a.dataset.cat === initial);
    apply(chip ? initial : "", chip ?? chips[0]);
  })();
</script>

<style>
  .hero {
    padding: 44px 0 30px;
    border-bottom: 1px solid var(--pc-line);
  }
  .eyebrow {
    font-family: var(--pc-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--pc-muted);
    margin: 0 0 14px;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(30px, 4.6vw, 46px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.18;
  }
  .lede {
    margin: 14px 0 0;
    max-width: 52ch;
    color: var(--pc-muted);
    font-size: 16.5px;
  }

  .spectrum {
    margin-top: 34px;
  }
  .bar {
    display: flex;
    height: 10px;
    border-radius: 99px;
    overflow: hidden;
    background: var(--pc-line);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .legend a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    background: var(--pc-surface);
    border: 1px solid var(--pc-line);
    border-radius: 99px;
    padding: 7px 14px 7px 11px;
    font-family: var(--pc-mono);
    font-size: 12px;
    font-weight: 500;
    color: inherit;
  }
  .legend a:hover {
    border-color: var(--pc-night);
  }
  .legend a[aria-current="true"] {
    background: var(--pc-night);
    border-color: var(--pc-night);
    color: #fff;
  }
  .legend .dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    flex: none;
  }
  .legend .n {
    color: var(--pc-muted);
    font-weight: 400;
  }
  .legend a[aria-current="true"] .n {
    color: #9fb6bc;
  }

  .more {
    display: inline-block;
    margin: 40px 0 20px;
    font-family: var(--pc-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-decoration: none;
    border: 1px solid var(--pc-night);
    color: var(--pc-night);
    border-radius: 99px;
    padding: 12px 24px;
  }
  .more:hover {
    background: var(--pc-night);
    color: #fff;
  }
  :global([data-theme="dark"]) .more {
    border-color: var(--pc-line);
    color: inherit;
  }
</style>
